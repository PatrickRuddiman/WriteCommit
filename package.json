{
  "name": "write-commit",
  "version": "1.0.0",
  "description": "A cross-platform tool to generate AI-powered commit messages",
  "main": "dist/index.js",
  "bin": {
    "write-commit": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rimraf dist",
    "test": "jest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "openai",
    "cli",
    "tool",
    "typescript"
  ],
  "author": "prudd",
  "license": "MIT",
  "homepage": "https://github.com/PatrickRuddiman/WriteCommit",
  "repository": {
    "type": "git",
    "url": "https://github.com/PatrickRuddiman/WriteCommit.git"
  },
  "bugs": {
    "url": "https://github.com/PatrickRuddiman/WriteCommit/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "patterns/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^11.1.0",
    "openai": "^4.52.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "ts-node": "^10.9.2",
    "rimraf": "^5.0.7",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0"
  }
}